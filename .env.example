# Copy to .env.local (never commit real values).
#
# Values: Supabase Dashboard → Project Settings → API Keys
# (local stack: printed by `npx supabase start` / `npx supabase status`).

# Public — inlined in the browser bundle at build time. Safe to expose: every
# request made with the publishable key is still subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server/CLI only — bypasses RLS. NEVER prefix with NEXT_PUBLIC_, never use it
# in src/. Only scripts in scripts/ (seed, catalogue import) read it. Not used in M1.
SUPABASE_SECRET_KEY=
