{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nis2-control",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild's keepNames injects `__name(...)` into functions that libraries
  // serialise with toString() (the next-themes inline script), which then
  // throws "__name is not defined" in the browser.
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
